[
    {
        "UpdateStageName": "Create serverfiles Directory",
        "UpdateSourcePlatform": "All",
        "UpdateSource": "CreateDirectory",
        "UpdateSourceArgs": "{{$FullBaseDir}}serverfiles"
    },
    {
        "UpdateStageName": "Create lib Directory",
        "UpdateSourcePlatform": "All",
        "UpdateSource": "CreateDirectory",
        "UpdateSourceArgs": "{{$FullBaseDir}}lib"
    },
    {
        "UpdateStageName": "Download Gamefiles",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "FetchURL",
        "UpdateSourceData": "http://linuxgsm.download/CallOfDuty2/cod2-lnxded-1.3-full.tar.xz",
        "UpdateSourceArgs": "cod2-lnxded-1.3-full.tar.xz",
        "UpdateSourceTarget": "{{$FullBaseDir}}",
        "UnzipUpdateSource": true,
        "OverwriteExistingFiles": true,
        "DeleteAfterExtract": true
    },
    {
        "UpdateStageName": "Factorio Extract",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "Executable",
        "UpdateSourceData": "/bin/bash",
        "UpdateSourceArgs": "-c \"cd serverfiles && tar -xJf cod2-lnxded-1.3-full.tar.xz --strip-components=1 >/dev/null 2>&1 && rm -f cod2-lnxded-1.3-full.tar.xz\"",
        "SkipOnFailure": false
    },
    {
        "UpdateStageName": "Make game executable",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "SetExecutableFlag",
        "UpdateSourceArgs": "./serverfiles/cod2_lnxded",
        "UnzipUpdateSource": false,
        "OverwriteExistingFiles": false,
        "DeleteAfterExtract": true,
        "OneShot": true
    },
    {
        "UpdateStageName": "Download gcc3-libs",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "FetchURL",
        "UpdateSourceData": "http://icculus.org/updates/cod/gcc3-libs.tar.bz2",
        "UpdateSourceArgs": "gcc3-libs.tar.bz2",
        "UpdateSourceTarget": "{{$FullBaseDir}}",
        "UnzipUpdateSource": true,
        "OverwriteExistingFiles": true,
        "DeleteAfterExtract": true
    },
    {
        "UpdateStageName": "Factorio Extract",
        "UpdateSourcePlatform": "Linux",
        "UpdateSource": "Executable",
        "UpdateSourceData": "/bin/bash",
        "UpdateSourceArgs": "-c \"cd lib && tar -xJf gcc3-libs.tar.bz2 --strip-components=1 >/dev/null 2>&1 && rm -f gcc3-libs.tar.bz2\"",
        "SkipOnFailure": false
    }
]
